# Copy this file to `.env` in this folder (hw4/.env) and fill in your own values.
# Never commit the real .env — it is listed in .gitignore.

# Required: Portkey gateway key used for Handsome Dan's AI calls (OpenAI via Portkey).
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional (defaults shown)
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_PROVIDER=openai
MODEL_NAME=gpt-6-luna
AGENT_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=60

# Optional: daily chat token budgets (tokens per day)
CHAT_DAILY_TOKENS_MEMBER=200000
CHAT_DAILY_TOKENS_GUEST=60000

# Auto-generated on first run into backend/.env if left empty — keep them secret and stable:
#   CHAT_ENCRYPTION_KEY  (Fernet key that encrypts saved chat messages)
#   AUDIT_SALT           (salt for anonymous actor ids in output/audit_trail.json)
# Do NOT set them here as empty values — leave these lines commented out.
# CHAT_ENCRYPTION_KEY=
# AUDIT_SALT=

# Optional: where the append-only audit trail is written (default: output/audit_trail.json)
# AUDIT_TRAIL_PATH=
